@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gep: <https://gep.com/ontology/login#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gep:AbstractUser a owl:Class ;
    rdfs:label "AbstractUser" ;
    rdfs:subClassOf [ owl:unionOf ( gep:User gep:UserDocument ) ] ;
    skos:definition "A person who has an account in the system",
        "Abstract base concept — a user account in the system" ;
    skos:inScheme gep: ;
    skos:prefLabel "User" .

<https://gep.com/ontology/login#AuthenticationTypeEnum#Password> a owl:Class ;
    rdfs:label "Password" ;
    rdfs:subClassOf gep:AuthenticationTypeEnum ;
    skos:definition "Standard username and password authentication" ;
    skos:prefLabel "Password" ;
    gep:integer_value "1" .

<https://gep.com/ontology/login#AuthenticationTypeEnum#SSO> a owl:Class ;
    rdfs:label "SSO" ;
    rdfs:subClassOf gep:AuthenticationTypeEnum ;
    skos:definition "Single Sign-On via SAML/OAuth/OIDC" ;
    skos:prefLabel "Single Sign-On" ;
    gep:integer_value "2" .

gep:MobileVerificationStatus a owl:Class ;
    rdfs:label "MobileVerificationStatus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty gep:isMobileNumberVerifiedSQL ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:username ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:username ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:isMobileNumberVerifiedSQL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isMobileNumberVerifiedSQL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:username ] ;
    skos:definition "SQL-side mobile verification record — um_usermobileverificationstatus" ;
    skos:inScheme gep: ;
    skos:note "Cross-checked against MongoDB UserDocument.isMobileNumberVerifiedMongo. A mismatch between the two is reported as a data sync issue." ;
    skos:prefLabel "Mobile Verification Status (SQL)" ;
    gep:datasource "sqlserver" ;
    gep:foreign_key "username → User.username" ;
    gep:table "um_usermobileverificationstatus" .

gep:userPartnerMapping a owl:ObjectProperty ;
    rdfs:label "userPartnerMapping" ;
    rdfs:range gep:PartnerMapping ;
    skos:definition "Embedded array of partner mappings in MongoDB user document. Mirrors the structure of SQL Um_Userpartnermapping." ;
    skos:inScheme gep: ;
    skos:prefLabel "User Partner Mapping (MongoDB)" ;
    gep:mirrors_sql_table "Um_Userpartnermapping" ;
    gep:mongo_field "userpartnermapping" .

gep:UserDocument a owl:Class ;
    rdfs:label "UserDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:isMobileNumberVerifiedMongo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mongoIsdCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:normalizedUserName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mongoLastName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mongoAuthenticationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mobileNo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mongoAuthenticationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mobileNo ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:PartnerMapping ;
            owl:onProperty gep:userPartnerMapping ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mongoIsdCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:normalizedUserName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:userName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mobileNo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:userPartnerMapping ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isMobileNumberVerifiedMongo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:userName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty gep:isMobileNumberVerifiedMongo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mongoFirstName ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:AuthenticationTypeEnum ;
            owl:onProperty gep:mongoAuthenticationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mongoFirstName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mongoLastName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:userName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:normalizedUserName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mongoFirstName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mongoLastName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mongoIsdCode ],
        gep:AbstractUser ;
    skos:definition "User document from MongoDB users collection" ;
    skos:inScheme gep: ;
    skos:note "Embeds userPartnerMapping array mirroring SQL Um_Userpartnermapping. isMobileNumberVerifiedMongo cross-checked with SQL isMobileNumberVerifiedSQL." ;
    skos:prefLabel "MongoDB User Document" ;
    gep:collection "users" ;
    gep:datasource "mongodb" ;
    gep:link_key "userName" .

gep:authenticationType a owl:ObjectProperty ;
    rdfs:label "authenticationType" ;
    rdfs:range gep:AuthenticationTypeEnum ;
    skos:definition "Authentication mechanism. Integer in both SQL and MongoDB. Validate: allowed values are 1 (Password) or 2 (SSO)." ;
    skos:inScheme gep: ;
    skos:prefLabel "Authentication Type" ;
    gep:mongo_field "authenticationType" ;
    gep:mongo_type "INT" ;
    gep:sql_column "authenticationtype" ;
    gep:sql_type "INT" .

gep:bpc a owl:DatatypeProperty ;
    rdfs:label "bpc" ;
    rdfs:range xsd:string ;
    skos:definition "Business Partner Code — parent grouping above partnerCode",
        "Higher-level partner grouping. partnerCode is a child of this value." ;
    skos:inScheme gep: ;
    skos:prefLabel "BPC" ;
    gep:hierarchy_role "parent" ;
    gep:sql_column "bpc" .

gep:emailAddress a owl:DatatypeProperty ;
    rdfs:label "emailAddress" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
    skos:definition "User email address" ;
    skos:inScheme gep: ;
    skos:prefLabel "Email Address" ;
    gep:sql_column "emailaddress" ;
    gep:sql_type "NVARCHAR" .

gep:firstName a owl:DatatypeProperty ;
    rdfs:label "firstName" ;
    rdfs:range xsd:string ;
    skos:definition "User first name (SQL)" ;
    skos:inScheme gep: ;
    skos:prefLabel "First Name" ;
    gep:sql_column "firstName" ;
    gep:sql_type "NVARCHAR" .

gep:hasMobileVerificationStatus a owl:ObjectProperty ;
    rdfs:label "hasMobileVerificationStatus" ;
    rdfs:range gep:MobileVerificationStatus ;
    skos:definition "Links a User to their mobile number verification record",
        "OWL ObjectProperty — semantic link from User to their MobileVerificationStatus. In SQL, resolved via the username FK. Used for OWL reasoning and KG traversal." ;
    skos:inScheme gep: ;
    skos:prefLabel "Has Mobile Verification Status" ;
    gep:resolution_via "username" .

gep:hasPartnerMappings a owl:ObjectProperty ;
    rdfs:label "hasPartnerMappings" ;
    rdfs:range gep:PartnerMapping ;
    owl:inverseOf gep:hasUser ;
    skos:definition "Links a User to all their partner mapping records",
        "OWL ObjectProperty — inverse of hasUser. Links a User to their PartnerMapping records. Used for KG traversal." ;
    skos:inScheme gep: ;
    skos:prefLabel "Has Partner Mappings" .

gep:isActive a owl:DatatypeProperty ;
    rdfs:label "isActive" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "SQL BIT — 0 means account is deactivated. Login is blocked when value = 0" ;
    skos:inScheme gep: ;
    skos:prefLabel "Is Active" ;
    gep:login_block_condition "value = 0" ;
    gep:sql_column "isactive" ;
    gep:sql_type "BIT" .

gep:isDefault a owl:DatatypeProperty ;
    rdfs:label "isDefault" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "SQL BIT — marks the default partner mapping for this user. Exactly one row per userId must have isDefault=1." ;
    skos:inScheme gep: ;
    skos:note "Business rule: exactly one isDefault=1 per userId. Multiple rows = data integrity bug." ;
    skos:prefLabel "Is Default Mapping" ;
    gep:sql_column "isdefault" ;
    gep:sql_type "BIT" ;
    gep:uniqueness_rule "exactly_one_true_per_userId" .

gep:isLocked a owl:DatatypeProperty ;
    rdfs:label "isLocked" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "SQL BIT — 1 means account is locked. Login is blocked when value = 1" ;
    skos:inScheme gep: ;
    skos:prefLabel "Is Locked" ;
    gep:login_block_condition "value = 1" ;
    gep:sql_column "islocked" ;
    gep:sql_type "BIT" .

gep:isMobileNumberVerifiedMongo a owl:DatatypeProperty ;
    rdfs:label "isMobileNumberVerifiedMongo" ;
    rdfs:range xsd:boolean ;
    skos:definition "MongoDB native boolean for mobile number verification. Cross-checked against SQL isMobileNumberVerifiedSQL after BIT normalization." ;
    skos:inScheme gep: ;
    skos:prefLabel "Is Mobile Verified (MongoDB)" ;
    gep:cross_source_check "MobileVerificationStatus.isMobileNumberVerifiedSQL" ;
    gep:mongo_field "ismobileNumberVerified" ;
    gep:normalization_note "Compare MongoDB true/false with SQL BIT 1/0 after normalization" .

gep:isMobileNumberVerifiedSQL a owl:DatatypeProperty ;
    rdfs:label "isMobileNumberVerifiedSQL" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "SQL BIT flag for mobile number verification. Cross-checked against MongoDB isMobileNumberVerifiedMongo. Mismatch = data sync issue — report directly, do not escalate to New Relic." ;
    skos:inScheme gep: ;
    skos:prefLabel "Is Mobile Verified (SQL)" ;
    gep:cross_source_check "UserDocument.isMobileNumberVerifiedMongo" ;
    gep:normalization_before_compare "BIT 0→false, 1→true" ;
    gep:sql_column "ismobilenumberverified" ;
    gep:sql_type "BIT" .

gep:lastName a owl:DatatypeProperty ;
    rdfs:label "lastName" ;
    rdfs:range xsd:string ;
    skos:definition "User last name (SQL)" ;
    skos:inScheme gep: ;
    skos:prefLabel "Last Name" ;
    gep:sql_column "lastName" ;
    gep:sql_type "NVARCHAR" .

gep:mappingId a owl:DatatypeProperty ;
    rdfs:label "mappingId" ;
    rdfs:range xsd:string ;
    skos:definition "Synthetic composite key for PartnerMapping. Generated as '{userId}_{bpc}_{partnerCode}'. Required because LinkML does not support composite identifiers natively." ;
    skos:inScheme gep: ;
    skos:prefLabel "Mapping ID" ;
    gep:derivation_rule "f'{userId}_{bpc}_{partnerCode}'" ;
    gep:derived_from "userId + bpc + partnerCode" .

gep:mappingIsActive a owl:DatatypeProperty ;
    rdfs:label "mappingIsActive" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "SQL BIT — 1 means this partner mapping row is active. Login blocked if no row with mappingIsActive=1 exists for the user." ;
    skos:inScheme gep: ;
    skos:prefLabel "Mapping Is Active" ;
    gep:login_block_condition "no row with value = 1 for this userId" ;
    gep:sql_column "isactive" ;
    gep:sql_type "BIT" .

gep:mongoAuthenticationType a owl:ObjectProperty ;
    rdfs:label "mongoAuthenticationType" ;
    rdfs:range gep:AuthenticationTypeEnum ;
    skos:definition "Authentication type in MongoDB (integer: 1=Password, 2=SSO)" ;
    skos:inScheme gep: ;
    skos:prefLabel "Authentication Type (MongoDB)" ;
    gep:mongo_field "authenticationType" ;
    gep:mongo_type "INT" .

gep:mongoFirstName a owl:DatatypeProperty ;
    rdfs:label "mongoFirstName" ;
    rdfs:range xsd:string ;
    skos:definition "First name in MongoDB users document" ;
    skos:inScheme gep: ;
    skos:prefLabel "First Name (MongoDB)" ;
    gep:mongo_field "firstName" .

gep:mongoLastName a owl:DatatypeProperty ;
    rdfs:label "mongoLastName" ;
    rdfs:range xsd:string ;
    skos:definition "Last name in MongoDB users document" ;
    skos:inScheme gep: ;
    skos:prefLabel "Last Name (MongoDB)" ;
    gep:mongo_field "lastName" .

gep:normalizedUserName a owl:DatatypeProperty ;
    rdfs:label "normalizedUserName" ;
    rdfs:range xsd:string ;
    skos:definition "Lowercase version of userName. Used for case-insensitive user lookups" ;
    skos:inScheme gep: ;
    skos:note "Derived field. Rule: lowercase(userName). Not authored — always computed." ;
    skos:prefLabel "Normalized Username" ;
    gep:derivation_rule "lowercase(userName)" ;
    gep:derived_from "userName" ;
    gep:mongo_field "normalizedUserName" .

gep:partnerCode a owl:DatatypeProperty ;
    rdfs:label "partnerCode" ;
    rdfs:range xsd:string ;
    skos:definition "Partner code — child code nested under a BPC group",
        "Specific partner identifier under a BPC group" ;
    skos:inScheme gep: ;
    skos:prefLabel "Partner Code" ;
    gep:hierarchy_role "child" ;
    gep:parent_slot "bpc" ;
    gep:sql_column "partnercode" .

gep:userName a owl:DatatypeProperty ;
    rdfs:label "userName" ;
    rdfs:range xsd:string ;
    skos:definition "MongoDB userName field. Cross-source link key to SQL UM_Users.username" ;
    skos:inScheme gep: ;
    skos:prefLabel "Username (MongoDB)" ;
    gep:cross_source_link "User.username" ;
    gep:mongo_field "userName" .

gep:PartnerMapping a owl:Class ;
    rdfs:label "PartnerMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:partnerCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mappingId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:bpc ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:bpc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isDefault ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:isDefault ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:mappingId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty gep:mappingIsActive ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:partnerCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:bpc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mappingIsActive ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty gep:isDefault ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mappingId ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:User ;
            owl:onProperty gep:hasUser ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mappingIsActive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:partnerCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:hasUser ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:hasUser ] ;
    skos:definition "Maps a user to BPC/partner codes — SQL Server Um_Userpartnermapping" ;
    skos:inScheme gep: ;
    skos:note "BPC is parent grouping; partnerCode is child under BPC. Exactly one row per user must have isDefault=1. At least one row with mappingIsActive=1 is required for login." ;
    skos:prefLabel "Partner Mapping" ;
    gep:datasource "sqlserver" ;
    gep:foreign_key "userId → User.userId" ;
    gep:table "Um_Userpartnermapping" .

gep:hasUser a owl:ObjectProperty ;
    rdfs:label "hasUser" ;
    rdfs:range gep:User ;
    owl:inverseOf gep:hasPartnerMappings ;
    skos:definition "Links a PartnerMapping record to the User it belongs to",
        "OWL ObjectProperty — semantic link from PartnerMapping to its owning User. In SQL, resolved via the integer userId FK. Not stored as a URI in the database; used by OWL reasoners and the KG to traverse the relationship." ;
    skos:inScheme gep: ;
    skos:prefLabel "Has User" ;
    gep:resolution_via "userId" .

gep:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:hasMobileVerificationStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty gep:isLocked ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:lastName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:hasMobileVerificationStatus ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:AuthenticationTypeEnum ;
            owl:onProperty gep:authenticationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:isLocked ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isdCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] ) ] ) ] ;
            owl:onProperty gep:emailAddress ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:firstName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:userId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isActive ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:lastName ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:PartnerMapping ;
            owl:onProperty gep:hasPartnerMappings ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:mobileNumber ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:emailAddress ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:mobileNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom gep:MobileVerificationStatus ;
            owl:onProperty gep:hasMobileVerificationStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:isLocked ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:firstName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty gep:isActive ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:username ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:emailAddress ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:isdCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:username ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty gep:authenticationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:isActive ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:username ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:mobileNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:firstName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gep:isdCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:lastName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty gep:authenticationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty gep:hasPartnerMappings ],
        gep:AbstractUser ;
    skos:definition "Core user record from SQL Server UM_Users table" ;
    skos:inScheme gep: ;
    skos:note "isLocked=1 OR isActive=0 blocks login. username is the cross-source link key to MongoDB users.userName." ;
    skos:prefLabel "SQL User" ;
    gep:datasource "sqlserver" ;
    gep:link_key "username" ;
    gep:primary_key "userId" ;
    gep:table "UM_Users" .

gep:isdCode a owl:DatatypeProperty ;
    rdfs:label "isdCode" ;
    rdfs:range xsd:string ;
    skos:definition "International dialing code (e.g. +91, +1). Co-dependent with mobileNumber" ;
    skos:example "+91, +1, +44" ;
    skos:inScheme gep: ;
    skos:prefLabel "ISD Code" ;
    gep:co_required_with "mobileNumber" ;
    gep:sql_column "isdCode" .

gep:mobileNo a owl:DatatypeProperty ;
    rdfs:label "mobileNo" ;
    rdfs:range xsd:string ;
    skos:definition "Mobile number in MongoDB. Co-dependent with mongoIsdCode" ;
    skos:inScheme gep: ;
    skos:prefLabel "Mobile No (MongoDB)" ;
    gep:co_required_with "mongoIsdCode" ;
    gep:mongo_field "mobileNo" .

gep:mobileNumber a owl:DatatypeProperty ;
    rdfs:label "mobileNumber" ;
    rdfs:range xsd:string ;
    skos:definition "Mobile phone number (SQL). Co-dependent with isdCode" ;
    skos:inScheme gep: ;
    skos:prefLabel "Mobile Number (SQL)" ;
    gep:co_required_with "isdCode" ;
    gep:sql_column "mobileNumber" .

gep:mongoIsdCode a owl:DatatypeProperty ;
    rdfs:label "mongoIsdCode" ;
    rdfs:range xsd:string ;
    skos:definition "International dialing code in MongoDB. Co-dependent with mobileNo" ;
    skos:inScheme gep: ;
    skos:prefLabel "ISD Code (MongoDB)" ;
    gep:co_required_with "mobileNo" ;
    gep:mongo_field "isdCode" .

gep:AuthenticationTypeEnum a owl:Class ;
    rdfs:label "AuthenticationTypeEnum" ;
    owl:unionOf ( <https://gep.com/ontology/login#AuthenticationTypeEnum#Password> <https://gep.com/ontology/login#AuthenticationTypeEnum#SSO> ) ;
    skos:definition "Authentication mechanism for login. Stored as integer in both SQL and MongoDB.",
        "Enumeration of allowed authentication mechanisms for user login." ;
    skos:inScheme gep: ;
    skos:prefLabel "Authentication Type" ;
    gep:storage_type "integer" ;
    linkml:permissible_values <https://gep.com/ontology/login#AuthenticationTypeEnum#Password>,
        <https://gep.com/ontology/login#AuthenticationTypeEnum#SSO> .

gep:userId a owl:DatatypeProperty ;
    rdfs:label "userId" ;
    rdfs:range xsd:integer ;
    skos:definition "Auto-increment integer primary key in SQL Server UM_Users",
        "Unique numeric identifier for a user record in SQL Server" ;
    skos:inScheme gep: ;
    skos:prefLabel "User ID" ;
    gep:sql_column "userid" ;
    gep:sql_type "INT" .

gep:username a owl:DatatypeProperty ;
    rdfs:label "username" ;
    rdfs:range xsd:string ;
    skos:definition "Unique username. Primary cross-source link key to MongoDB users.userName" ;
    skos:inScheme gep: ;
    skos:note "Case-insensitive. Matches MongoDB userName and normalizedUserName" ;
    skos:prefLabel "Username" ;
    gep:cross_source_link "UserDocument.userName" ;
    gep:sql_column "username" ;
    gep:sql_type "NVARCHAR" .

xsd:integer a rdfs:Datatype .

gep: a owl:Ontology ;
    rdfs:label "login" ;
    dcterms:title "Login Query Agent Ontology" ;
    pav:version "1.0.0" ;
    skos:definition "Domain ontology for the Login Query Agent. Models user identity, partner mapping, and mobile verification across SQL Server and MongoDB. Drives datasource routing, SHACL validation, and New Relic escalation rules." .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gep:isdCode ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty gep:mobileNumber ;
                owl:someValuesFrom xsd:string ] gep:User ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gep:mobileNumber ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty gep:isdCode ;
                owl:someValuesFrom xsd:string ] gep:User ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gep:mongoIsdCode ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty gep:mobileNo ;
                owl:someValuesFrom xsd:string ] gep:UserDocument ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gep:mobileNo ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty gep:mongoIsdCode ;
                owl:someValuesFrom xsd:string ] gep:UserDocument ) .


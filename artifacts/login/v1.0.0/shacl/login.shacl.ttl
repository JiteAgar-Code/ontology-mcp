@prefix gep: <https://gep.com/ontology/login#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gep:AbstractUser a sh:NodeShape ;
    rdfs:comment "Abstract base concept — a user account in the system" ;
    sh:closed false ;
    sh:ignoredProperties ( gep:mongoLastName gep:authenticationType gep:isdCode gep:mongoFirstName gep:hasPartnerMappings gep:isMobileNumberVerifiedMongo gep:isActive gep:mobileNo gep:isLocked gep:userPartnerMapping gep:emailAddress gep:userId gep:firstName gep:mobileNumber gep:username rdf:type gep:normalizedUserName gep:mongoIsdCode gep:mongoAuthenticationType gep:userName gep:lastName gep:hasMobileVerificationStatus ) ;
    sh:targetClass gep:AbstractUser .

gep:UserDocument a sh:NodeShape ;
    rdfs:comment "User document from MongoDB users collection" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Last name in MongoDB users document" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gep:mongoLastName ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile number in MongoDB. Co-dependent with mongoIsdCode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gep:mobileNo ],
        [ sh:datatype xsd:string ;
            sh:description "Lowercase version of userName. Used for case-insensitive user lookups" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gep:normalizedUserName ],
        [ sh:datatype xsd:string ;
            sh:description "International dialing code in MongoDB. Co-dependent with mobileNo" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gep:mongoIsdCode ],
        [ sh:datatype xsd:string ;
            sh:description "First name in MongoDB users document" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gep:mongoFirstName ],
        [ sh:datatype xsd:string ;
            sh:description "MongoDB userName field. Cross-source link key to SQL UM_Users.username" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gep:userName ],
        [ sh:datatype xsd:boolean ;
            sh:description "MongoDB native boolean for mobile number verification. Cross-checked against SQL isMobileNumberVerifiedSQL after BIT normalization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gep:isMobileNumberVerifiedMongo ],
        [ sh:class gep:PartnerMapping ;
            sh:description "Embedded array of partner mappings in MongoDB user document. Mirrors the structure of SQL Um_Userpartnermapping." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path gep:userPartnerMapping ],
        [ sh:description "Authentication type in MongoDB (integer: 1=Password, 2=SSO)" ;
            sh:in ( "Password" "SSO" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path gep:mongoAuthenticationType ] ;
    sh:targetClass gep:UserDocument .

gep:MobileVerificationStatus a sh:NodeShape ;
    rdfs:comment "SQL-side mobile verification record — um_usermobileverificationstatus" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique username. Primary cross-source link key to MongoDB users.userName" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gep:username ],
        [ sh:datatype xsd:integer ;
            sh:description "SQL BIT flag for mobile number verification. Cross-checked against MongoDB isMobileNumberVerifiedMongo. Mismatch = data sync issue — report directly, do not escalate to New Relic." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gep:isMobileNumberVerifiedSQL ] ;
    sh:targetClass gep:MobileVerificationStatus .

gep:User a sh:NodeShape ;
    rdfs:comment "Core user record from SQL Server UM_Users table" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "User last name (SQL)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gep:lastName ],
        [ sh:datatype xsd:string ;
            sh:description "Unique username. Primary cross-source link key to MongoDB users.userName" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gep:username ],
        [ sh:datatype xsd:string ;
            sh:description "International dialing code (e.g. +91, +1). Co-dependent with mobileNumber" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path gep:isdCode ],
        [ sh:datatype xsd:integer ;
            sh:description "Auto-increment integer primary key in SQL Server UM_Users" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gep:userId ],
        [ sh:datatype xsd:string ;
            sh:description "User email address" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path gep:emailAddress ;
            sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile phone number (SQL). Co-dependent with isdCode" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path gep:mobileNumber ],
        [ sh:description "Authentication mechanism. Integer in both SQL and MongoDB. Validate: allowed values are 1 (Password) or 2 (SSO)." ;
            sh:in ( "Password" "SSO" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path gep:authenticationType ],
        [ sh:class gep:PartnerMapping ;
            sh:description "OWL ObjectProperty — inverse of hasUser. Links a User to their PartnerMapping records. Used for KG traversal." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path gep:hasPartnerMappings ],
        [ sh:datatype xsd:string ;
            sh:description "User first name (SQL)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gep:firstName ],
        [ sh:class gep:MobileVerificationStatus ;
            sh:description "OWL ObjectProperty — semantic link from User to their MobileVerificationStatus. In SQL, resolved via the username FK. Used for OWL reasoning and KG traversal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path gep:hasMobileVerificationStatus ],
        [ sh:datatype xsd:integer ;
            sh:description "SQL BIT — 0 means account is deactivated. Login is blocked when value = 0" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path gep:isActive ],
        [ sh:datatype xsd:integer ;
            sh:description "SQL BIT — 1 means account is locked. Login is blocked when value = 1" ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gep:isLocked ] ;
    sh:targetClass gep:User .

gep:PartnerMapping a sh:NodeShape ;
    rdfs:comment "Maps a user to BPC/partner codes — SQL Server Um_Userpartnermapping" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Partner code — child code nested under a BPC group" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path gep:partnerCode ],
        [ sh:datatype xsd:integer ;
            sh:description "SQL BIT — marks the default partner mapping for this user. Exactly one row per userId must have isDefault=1." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path gep:isDefault ],
        [ sh:class gep:User ;
            sh:description "OWL ObjectProperty — semantic link from PartnerMapping to its owning User. In SQL, resolved via the integer userId FK. Not stored as a URI in the database; used by OWL reasoners and the KG to traverse the relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path gep:hasUser ],
        [ sh:datatype xsd:string ;
            sh:description "Synthetic composite key for PartnerMapping. Generated as '{userId}_{bpc}_{partnerCode}'. Required because LinkML does not support composite identifiers natively." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path gep:mappingId ],
        [ sh:datatype xsd:string ;
            sh:description "Business Partner Code — parent grouping above partnerCode" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path gep:bpc ],
        [ sh:datatype xsd:integer ;
            sh:description "Auto-increment integer primary key in SQL Server UM_Users" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path gep:userId ],
        [ sh:datatype xsd:integer ;
            sh:description "SQL BIT — 1 means this partner mapping row is active. Login blocked if no row with mappingIsActive=1 exists for the user." ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path gep:mappingIsActive ] ;
    sh:targetClass gep:PartnerMapping .



# ════════════════════════════════════════════════
# CUSTOM SHAPES (injected by gen_shacl.py)
# ════════════════════════════════════════════════

gep:PartnerMappingShape a sh:NodeShape ;
    sh:targetClass gep:PartnerMapping ;
    sh:sparql [
        sh:message "No active partner mapping (mappingIsActive=1) found for user. Login blocked." ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gep" ;
                sh:namespace "https://gep.com/ontology/login#" ;
            ]
        ] ;
        sh:select """
          PREFIX gep: <https://gep.com/ontology/login#> SELECT $this WHERE {
            $this gep:userId ?uid .
            FILTER NOT EXISTS {
              ?m gep:userId ?uid ;
                 gep:mappingIsActive 1 .
            }
          }
        """ ;
    ] .


gep:DefaultPartnerShape a sh:NodeShape ;
    sh:targetClass gep:PartnerMapping ;
    sh:sparql [
        sh:message "User must have exactly one default partner mapping (isDefault=1)." ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gep" ;
                sh:namespace "https://gep.com/ontology/login#" ;
            ]
        ] ;
        sh:select """
          PREFIX gep: <https://gep.com/ontology/login#> SELECT $this WHERE {
            $this gep:userId ?uid .
            {
              SELECT ?uid (COUNT(?d) AS ?cnt) WHERE {
                ?d gep:userId ?uid ;
                   gep:isDefault 1 .
              } GROUP BY ?uid
            }
            FILTER (?cnt != 1)
          }
        """ ;
    ] .


# ── Custom Python Shape (not executable SHACL) ──────────────
# Shape ID   : gep:MobileConsistencyShape
# Implemented: mcp_server.tools.validate_data.MobileConsistencyValidator
# Logic      :
#   1. Fetch MobileVerificationStatus.isMobileNumberVerifiedSQL for the user (SQL BIT). 2. Normalize SQL BIT: 0→False, 1→True. 3. Fetch UserDocument.isMobileNumberVerifiedMongo for the user (MongoDB boolean). 4. Compare normalized values. If different → violation.
#
gep:MobileConsistencyShape a sh:NodeShape ;
    rdfs:comment "CUSTOM_PYTHON: mcp_server.tools.validate_data.MobileConsistencyValidator" ;
    sh:message "Mobile verification mismatch for '{username}': SQL={source_a_value}, MongoDB={source_b_value}." .

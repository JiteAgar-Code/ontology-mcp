{
  "schema": "login",
  "version": "1.0.0",
  "namespace": "http://gep.com/ontology/login#",
  "descriptors": {
    "User": {
      "class": "User",
      "datasource": "sqlserver",
      "version": "1.0.0",
      "table": "UM_Users",
      "link_key": "username",
      "primary_key": "userId",
      "properties": [
        {
          "name": "userId",
          "range": "integer",
          "required": true,
          "sql_column": "userid",
          "sql_type": "INT"
        },
        {
          "name": "username",
          "range": "string",
          "required": true,
          "sql_column": "username",
          "sql_type": "NVARCHAR",
          "cross_source_link": "UserDocument.userName"
        },
        {
          "name": "emailAddress",
          "range": "string",
          "required": true,
          "sql_column": "emailaddress",
          "sql_type": "NVARCHAR",
          "mongo_field": "emailAddress"
        },
        {
          "name": "firstName",
          "range": "string",
          "required": false,
          "sql_column": "firstname",
          "sql_type": "NVARCHAR",
          "mongo_field": "firstName"
        },
        {
          "name": "lastName",
          "range": "string",
          "required": false,
          "sql_column": "lastname",
          "sql_type": "NVARCHAR",
          "mongo_field": "lastName"
        },
        {
          "name": "userType",
          "range": "UserTypeEnum",
          "required": false,
          "sql_column": "usertype",
          "sql_type": "INT",
          "mongo_field": "userType",
          "mongo_type": "INT"
        },
        {
          "name": "authenticationType",
          "range": "AuthenticationTypeEnum",
          "required": true,
          "sql_column": "authenticationtype",
          "sql_type": "INT",
          "mongo_field": "authenticationType",
          "mongo_type": "INT",
          "enum_integer_map": {
            "1": "Password",
            "2": "SSO"
          }
        },
        {
          "name": "isLocked",
          "range": "SqlBit",
          "required": false,
          "sql_column": "islocked",
          "sql_type": "BIT",
          "normalize_to_bool": true,
          "login_block_condition": "value = 1"
        },
        {
          "name": "isActive",
          "range": "SqlBit",
          "required": false,
          "sql_column": "isactive",
          "sql_type": "BIT",
          "normalize_to_bool": true,
          "login_block_condition": "value = 0"
        },
        {
          "name": "isDeleted",
          "range": "SqlBit",
          "required": false,
          "sql_column": "isdeleted",
          "sql_type": "BIT",
          "normalize_to_bool": true,
          "login_block_condition": "value = 1"
        },
        {
          "name": "isSystemUser",
          "range": "SqlBit",
          "required": false,
          "sql_column": "issystemuser",
          "sql_type": "BIT",
          "normalize_to_bool": true
        },
        {
          "name": "isdCode",
          "range": "string",
          "required": false,
          "sql_column": "isdcode",
          "co_required_with": "mobileNumber"
        },
        {
          "name": "mobileNumber",
          "range": "string",
          "required": false,
          "sql_column": "mobileno",
          "co_required_with": "isdCode"
        },
        {
          "name": "hasMobileVerificationStatus",
          "range": "MobileVerificationStatus",
          "required": false,
          "owl_object_property": true,
          "resolution_via": "username"
        },
        {
          "name": "hasPartnerMappings",
          "range": "PartnerMapping",
          "required": false,
          "owl_object_property": true,
          "resolution_via": null
        }
      ],
      "login_block_conditions": [
        {
          "property": "isLocked",
          "condition": "value = 1"
        },
        {
          "property": "isActive",
          "condition": "value = 0"
        },
        {
          "property": "isDeleted",
          "condition": "value = 1"
        }
      ]
    },
    "PartnerMapping": {
      "class": "PartnerMapping",
      "datasource": "sqlserver",
      "version": "1.0.0",
      "table": "UM_UserPartnermapping",
      "foreign_key": "userId → User.userId",
      "properties": [
        {
          "name": "userId",
          "range": "integer",
          "required": true,
          "sql_column": "userid",
          "sql_type": "INT"
        },
        {
          "name": "hasUser",
          "range": "User",
          "required": false,
          "owl_object_property": true,
          "resolution_via": "userId"
        },
        {
          "name": "bpc",
          "range": "integer",
          "required": true,
          "sql_column": "bpc",
          "sql_type": "BIGINT"
        },
        {
          "name": "partnerCode",
          "range": "integer",
          "required": true,
          "sql_column": "partnercode",
          "sql_type": "INT"
        },
        {
          "name": "mappingIsActive",
          "range": "SqlBit",
          "required": false,
          "sql_column": "isactive",
          "sql_type": "BIT",
          "normalize_to_bool": true,
          "login_block_condition": "no row with value = 1 for this userId"
        },
        {
          "name": "contactCode",
          "range": "integer",
          "required": false,
          "sql_column": "contactcode",
          "sql_type": "BIGINT"
        }
      ],
      "login_block_conditions": [
        {
          "property": "mappingIsActive",
          "condition": "no row with value = 1 for this userId"
        }
      ]
    },
    "MobileVerificationStatus": {
      "class": "MobileVerificationStatus",
      "datasource": "sqlserver",
      "version": "1.0.0",
      "table": "UM_UserMobileNumberVerified",
      "foreign_key": "username → User.username",
      "properties": [
        {
          "name": "username",
          "range": "string",
          "required": true,
          "sql_column": "username",
          "sql_type": "NVARCHAR",
          "cross_source_link": "UserDocument.userName"
        },
        {
          "name": "isMobileNumberVerified",
          "range": "SqlBit",
          "required": true,
          "sql_column": "ismobilenumberverified",
          "sql_type": "BIT",
          "normalize_to_bool": true,
          "cross_source_check": "UserDocument.isMobileNumberVerifiedMongo",
          "normalization": "BIT 0→false, 1→true"
        }
      ]
    },
    "IsdCode": {
      "class": "IsdCode",
      "datasource": "mongodb",
      "version": "1.0.0",
      "collection": null,
      "properties": [
        {
          "name": "isdCountryCode",
          "range": "string",
          "required": false,
          "mongo_field": "countryCode"
        },
        {
          "name": "isdExtension",
          "range": "string",
          "required": false,
          "mongo_field": "extension"
        }
      ]
    },
    "MongoPartnerMapping": {
      "class": "MongoPartnerMapping",
      "datasource": "mongodb",
      "version": "1.0.0",
      "collection": null,
      "properties": [
        {
          "name": "mongoMappingUserId",
          "range": "string",
          "required": false,
          "mongo_field": "userId"
        },
        {
          "name": "mongoBpc",
          "range": "integer",
          "required": false,
          "mongo_field": "bpc",
          "mongo_type": "INT"
        },
        {
          "name": "mongoPartnerCode",
          "range": "integer",
          "required": false,
          "mongo_field": "partnerCode",
          "mongo_type": "INT"
        },
        {
          "name": "mongoMappingIsActive",
          "range": "boolean",
          "required": false,
          "mongo_field": "isActive"
        },
        {
          "name": "mongoContactCode",
          "range": "string",
          "required": false,
          "mongo_field": "contactCode"
        }
      ]
    },
    "UserDocument": {
      "class": "UserDocument",
      "datasource": "mongodb",
      "version": "1.0.0",
      "collection": "users",
      "link_key": "userName",
      "properties": [
        {
          "name": "userName",
          "range": "string",
          "required": true,
          "mongo_field": "userName",
          "cross_source_link": "User.username"
        },
        {
          "name": "emailAddress",
          "range": "string",
          "required": true,
          "sql_column": "emailaddress",
          "sql_type": "NVARCHAR",
          "mongo_field": "emailAddress"
        },
        {
          "name": "firstName",
          "range": "string",
          "required": false,
          "sql_column": "firstname",
          "sql_type": "NVARCHAR",
          "mongo_field": "firstName"
        },
        {
          "name": "lastName",
          "range": "string",
          "required": false,
          "sql_column": "lastname",
          "sql_type": "NVARCHAR",
          "mongo_field": "lastName"
        },
        {
          "name": "userType",
          "range": "UserTypeEnum",
          "required": false,
          "sql_column": "usertype",
          "sql_type": "INT",
          "mongo_field": "userType",
          "mongo_type": "INT"
        },
        {
          "name": "authenticationType",
          "range": "AuthenticationTypeEnum",
          "required": true,
          "sql_column": "authenticationtype",
          "sql_type": "INT",
          "mongo_field": "authenticationType",
          "mongo_type": "INT",
          "enum_integer_map": {
            "1": "Password",
            "2": "SSO"
          }
        },
        {
          "name": "normalizedUserName",
          "range": "string",
          "required": false,
          "mongo_field": "normalizedUserName",
          "derived_from": "userName",
          "derivation_rule": "lowercase(userName)"
        },
        {
          "name": "normalizedEmailAddress",
          "range": "string",
          "required": false,
          "mongo_field": "normalizedEmailAddress",
          "derived_from": "emailAddress",
          "derivation_rule": "lowercase(emailAddress)"
        },
        {
          "name": "normalizedFirstName",
          "range": "string",
          "required": false,
          "mongo_field": "normalizedFirstName",
          "derived_from": "firstName",
          "derivation_rule": "lowercase(firstName)"
        },
        {
          "name": "normalizedLastName",
          "range": "string",
          "required": false,
          "mongo_field": "normalizedLastName",
          "derived_from": "lastName",
          "derivation_rule": "lowercase(lastName)"
        },
        {
          "name": "normalizedFullName",
          "range": "string",
          "required": false,
          "mongo_field": "normalizedFullName",
          "derived_from": "firstName + lastName",
          "derivation_rule": "lowercase(firstName + ' ' + lastName)"
        },
        {
          "name": "mongoIsActive",
          "range": "boolean",
          "required": false,
          "mongo_field": "isActive"
        },
        {
          "name": "mongoIsLocked",
          "range": "boolean",
          "required": false,
          "mongo_field": "isLocked"
        },
        {
          "name": "mongoIsSystemUser",
          "range": "boolean",
          "required": false,
          "mongo_field": "isSystemUser"
        },
        {
          "name": "mongoIsdCode",
          "range": "IsdCode",
          "required": false,
          "mongo_field": "isdCode",
          "co_required_with": "mobileNo"
        },
        {
          "name": "mobileNo",
          "range": "string",
          "required": false,
          "mongo_field": "mobileNo",
          "co_required_with": "mongoIsdCode"
        },
        {
          "name": "isMobileNumberVerifiedMongo",
          "range": "boolean",
          "required": false,
          "mongo_field": "isMobileNumberVerified",
          "cross_source_check": "MobileVerificationStatus.isMobileNumberVerified",
          "normalization": "Compare MongoDB true/false with SQL BIT 1/0 after normalization"
        },
        {
          "name": "userPartnerMappings",
          "range": "MongoPartnerMapping",
          "required": false,
          "mongo_field": "userPartnerMappings"
        }
      ]
    }
  }
}